# Postgres connection used by the app and drizzle-kit
DATABASE_URL=postgres://forge:forge@127.0.0.1:5433/forge

# HTTP port
PORT=3000

# --- Server exposure and access (security) ---
# Forge can run code on this machine, so it listens on localhost only by default.
# To listen on another address you MUST set FORGE_API_TOKEN (24+ chars: openssl rand -hex 32).
# Browser sign-in: open http://<host>:<port>/?token=<FORGE_API_TOKEN> once (sets an HttpOnly cookie).
# API clients: send  Authorization: Bearer <FORGE_API_TOKEN>
# FORGE_HOST=127.0.0.1
# FORGE_API_TOKEN=
# Extra host names the server answers to (behind a proxy or a LAN name), comma separated.
# FORGE_ALLOWED_HOSTS=
# Max state-changing requests per client per minute.
# FORGE_WRITE_LIMIT_PER_MINUTE=120
# Postgres password used by docker compose (also update DATABASE_URL).
# POSTGRES_PASSWORD=

# Agents and the commands they run get an allowlisted environment (no DATABASE_URL, no keys).
# Add extra variable names they genuinely need, comma separated.
# FORGE_CHILD_ENV_PASSTHROUGH=

# --- Claude Code runtime auth (M3+) ---
# Forge's ClaudeCodeRuntime uses the Claude Code SUBSCRIPTION session.
# In CI, set CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`).
# NEVER set ANTHROPIC_API_KEY here — it overrides subscription billing and
# forces per-token charges. See docs/ARCHITECTURE.md §7.1.
# CLAUDE_CODE_OAUTH_TOKEN=
# Claude Code program to run. By default Forge uses the one bundled with the SDK, or the
# `claude` on PATH when that optional download was skipped.
# FORGE_CLAUDE_PATH=

# --- Worker command sandbox (M12) ---
# Where worker shell commands AND test/acceptance checks execute.
#   (unset) | host   → run on the host (dev default, no isolation)
#   docker          → run each command in an ephemeral, network-less container
#                     with only the workspace mounted (no host FS/network).
# FORGE_SANDBOX=docker
# FORGE_SANDBOX_IMAGE=node:20-alpine
# FORGE_SANDBOX_MEMORY=1g
# FORGE_SANDBOX_CPUS=2

# --- Agent command isolation (Claude Code sandbox) ---
# on (default)  sandbox the agents' shell commands where the platform supports it
# required      refuse to run an agent unsandboxed (use on Linux/WSL2/macOS)
# off           no sandbox: agent commands run as your user
# Native Windows: Claude Code cannot sandbox yet, so run Forge in WSL2 or Linux for real isolation.
# FORGE_AGENT_SANDBOX=on

# --- Projects ---
# Root folder for everything Forge builds: <root>/<company>/<project>. Default: ~/Forge Projects
# FORGE_PROJECTS_DIR=
# How many specialists a planning executive may hire per goal (0 disables hiring).
# FORGE_MAX_HIRES_PER_GOAL=2

# --- Never run out: automatic fallback while Claude is at its usage limit ---
# Any OpenAI-compatible endpoint: an AI gateway such as OmniRoute or OpenRouter, or OpenAI itself.
# Work switches here automatically when Claude Code hits its limit and returns to Claude after the reset.
# The key stays inside Forge; agents and their commands never see it.
#   OpenRouter: FORGE_FALLBACK_BASE_URL=https://openrouter.ai/api/v1   FORGE_FALLBACK_MODEL=openrouter/auto (or a model id)
#   OmniRoute:  FORGE_FALLBACK_BASE_URL=<your OmniRoute URL ending in /v1>   FORGE_FALLBACK_MODEL=<a model or combo it serves>
# FORGE_FALLBACK_BASE_URL=
# FORGE_FALLBACK_API_KEY=
# FORGE_FALLBACK_MODEL=
# FORGE_FALLBACK_AUTO=1

# Keep Windows from sleeping while work is in progress (released when idle). 0 = off.
# FORGE_KEEP_AWAKE=1

# A run stopped by its time/tool/turn limit after changing files continues without using an attempt,
# up to this many times per step.
# FORGE_MAX_CONTINUATIONS=6

# --- Throughput ---
# Runs at the same time, and people per role when Forge adds teammates for a queue.
# FORGE_CONCURRENCY=5
# FORGE_MAX_PER_ROLE=3
# 0 = never add teammates automatically.
# FORGE_AUTOSTAFF=1
# Time per run before it continues in a new run, and failed attempts before a step fails.
# FORGE_MAX_RUN_MINUTES=30
# FORGE_MAX_ATTEMPTS=3

# --- Planning ---
# Most steps in a plan; 0 skips the automatic final independent review.
# FORGE_MAX_PLAN_ITEMS=12
# FORGE_PRODUCTION_REVIEW=1

# --- Checks ---
# Earlier steps' acceptance checks re-run on every new step before it merges.
# FORGE_MAX_REGRESSION_CHECKS=30
# Visual review of UIs: 0 = off; the score a screen must reach; the reviewing model; the browser used.
# FORGE_VISUAL_GATE=1
# FORGE_VISUAL_MIN_SCORE=85
# FORGE_VISUAL_MODEL=opus
# FORGE_BROWSER_PATH=

# --- Fallback tuning ---
# Time limit per fallback call (ms).
# FORGE_FALLBACK_TIMEOUT_MS=120000

# --- Keep awake (Windows) ---
# The display is kept on too while work is queued: on Modern Standby PCs the screen turning off IS sleep.
# 0 = keep only the system awake.
# FORGE_KEEP_DISPLAY_ON=1

# --- Brands ---
# Folder of brand systems every UI follows. Default: brands/ in this repository.
# FORGE_BRANDS_DIR=

# --- Accounts ---
# 1 = mark the session cookie Secure (set when Forge is served over HTTPS).
# FORGE_SECURE_COOKIES=0

# --- Other runtimes (optional) ---
# Per-token Anthropic API for custom-runtime workers only (never ANTHROPIC_API_KEY).
# FORGE_ANTHROPIC_API_KEY=
# Local model server for the ollama provider.
# FORGE_OLLAMA_HOST=http://localhost:11434
