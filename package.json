{
  "name": "forge-ai",
  "version": "0.1.0",
  "description": "An AI company on your own machine: an executive plans your idea, specialists build it in parallel, every step is tested before it is accepted.",
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "claude",
    "claude-code",
    "autonomous",
    "multi-agent",
    "code-generation"
  ],
  "homepage": "https://sahil1188.github.io/Forge/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sahil1188/Forge.git"
  },
  "bugs": {
    "url": "https://github.com/Sahil1188/Forge/issues"
  },
  "license": "MIT",
  "author": "Sahil Shaikh",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "forge": "bin/forge.cjs"
  },
  "files": [
    "dist",
    "src",
    "public",
    "bin",
    "brands",
    "drizzle",
    "docker-compose.yml",
    "drizzle.config.ts",
    "tsconfig.json",
    ".env.example",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "forge": "tsx bin/forge.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "playwright-core": "^1.49.1",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.10.7",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-swc": "^1.5.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
